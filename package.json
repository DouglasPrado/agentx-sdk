{
  "name": "agentx-sdk",
  "version": "0.6.6",
  "description": "AgentX SDK - Standalone TypeScript agent library with streaming, tools, memory, knowledge (RAG), and skills",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:deadcode": "knip",
    "lint:dup": "jscpd src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:publish": "publint && attw --pack . --ignore-rules cjs-resolves-to-esm",
    "docs:dev": "cd documentation && npx mintlify@latest dev",
    "docs:build": "cd documentation && npx mintlify@latest build",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DouglasPrado/agentx-sdk.git"
  },
  "homepage": "https://github.com/DouglasPrado/agentx-sdk#readme",
  "bugs": {
    "url": "https://github.com/DouglasPrado/agentx-sdk/issues"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-sonarjs": "^4.0.3",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.9",
    "knip": "^6.11.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "publint": "^0.3.18",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.2",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "overrides": {
    "hono": ">=4.12.14",
    "@hono/node-server": ">=1.19.13",
    "postcss": ">=8.5.10"
  },
  "pnpm": {
    "overrides": {
      "hono": ">=4.12.14",
      "@hono/node-server": ">=1.19.13",
      "postcss": ">=8.5.10"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "license": "MIT"
}
