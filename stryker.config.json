{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing — pnpm requer plugins explicitos pq o auto-discovery nao acha em .pnpm/",
  "packageManager": "pnpm",
  "plugins": ["@stryker-mutator/vitest-runner", "@stryker-mutator/typescript-checker"],
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "coverageAnalysis": "perTest",
  "mutate": ["src/**/*.ts", "!src/index.ts", "!src/**/index.ts", "!src/contracts/**"],
  "ignorePatterns": [
    "dist",
    "documentation",
    "docs",
    "examples",
    "data",
    "coverage",
    ".agentx",
    ".pnpm-store",
    ".stryker-tmp",
    "reports",
    "sdk"
  ],
  "incremental": true,
  "incrementalFile": "reports/mutation/.stryker-incremental.json",
  "reporters": ["progress", "clear-text", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "_comment": "Baseline atual: 52.68%. break=50 = nao deixa regredir. high=80/low=60 = alvo aspiracional pra ratchet up ao longo do tempo.",
    "high": 80,
    "low": 60,
    "break": 50
  },
  "timeoutMS": 60000,
  "concurrency": 4
}
